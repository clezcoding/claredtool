{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clared Tax Rule",
  "type": "object",
  "properties": {
    "rule_id": { "type": "string" },
    "version": { "type": "string" },
    "jurisdiction_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "description": { "type": "string" },
    "conditions": {
      "type": "object",
      "properties": {
        "supplier_country": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "customer_country": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "supplier_is_business": { "type": "boolean" },
        "customer_is_business": { "type": "boolean" },
        "supplier_vat_registered": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        },
        "customer_vat_registered": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        },
        "supply_type": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "channel": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "effective_from": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "effective_to": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "threshold_amount": {
          "anyOf": [
            { "type": "number" },
            { "type": "null" }
          ]
        },
        "threshold_currency": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "properties": {
        "place_of_supply_country": { "type": "string" },
        "tax_liability_party": { "type": "string", "enum": ["supplier", "customer"] },
        "invoice_tax_rate": {
          "anyOf": [
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "invoice_tax_shown": { "type": "boolean" },
        "reverse_charge_flag": { "type": "boolean" },
        "legal_reference": { "type": "string" },
        "invoice_text_block_id": { "type": "string" },
        "additional_outputs": { "type": "object" }
      },
      "required": ["place_of_supply_country", "tax_liability_party"]
    },
    "priority": { "type": "integer" },
    "source_citation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["rule_id", "version", "conditions", "effect"],
  "additionalProperties": false
}
