{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clared Tax Rule",
  "type": "object",
  "properties": {
    "rule_id": { "type": "string" },
    "version": { "type": "string" },
    "jurisdiction_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "description": { "type": "string" },
    "conditions": {
      "type": "object",
      "properties": {
        "supplier_country": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "customer_country": { "type": ["string", "array"] },
        "supplier_is_business": { "type": "boolean" },
        "customer_is_business": { "type": "boolean" },
        "supplier_vat_registered": { "type": ["boolean", "string"] },
        "customer_vat_registered": { "type": ["boolean", "string"] },
        "supply_type": { "type": ["string", "array"] },
        "channel": { "type": ["string", "array", "null"] },
        "effective_from": { "type": ["string", "null"], "format": "date" },
        "effective_to": { "type": ["string", "null"], "format": "date" },
        "threshold_amount": { "type": ["number", "null"] },
        "threshold_currency": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "properties": {
        "place_of_supply_country": { "type": "string" },
        "tax_liability_party": { "type": "string", "enum": ["supplier", "customer"] },
        "invoice_tax_rate": { "type": ["number", "string"] },
        "invoice_tax_shown": { "type": "boolean" },
        "reverse_charge_flag": { "type": "boolean" },
        "legal_reference": { "type": "string" },
        "invoice_text_block_id": { "type": "string" },
        "additional_outputs": { "type": "object" }
      },
      "required": ["place_of_supply_country", "tax_liability_party"]
    },
    "priority": { "type": "integer" },
    "source_citation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["rule_id", "version", "conditions", "effect"],
  "additionalProperties": false
}
