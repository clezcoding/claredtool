{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Phase 4.3: fs/dialog/sharekit on main is intentional for Phase 5 offline prep; tighten to debug.json before shipping product flows.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "opener:default",
    "deep-link:default",
    "os:allow-hostname",
    "store:default",
    "allow-keychain-set-session",
    "allow-keychain-get-session",
    "allow-keychain-delete-session",
    "allow-open-login-window",
    "window-state:default",
    "notification:default",
    "log:default",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "sharekit:default",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$TEMP" },
        { "path": "$TEMP/**" }
      ]
    }
  ]
}
