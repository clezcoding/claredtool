# Local OrbStack (D-03): Authentik from compose.yml, Clared Postgres+Redis from
# compose.clared.yml. Nest runs on the host, not in Compose.
#
#   docker compose -f compose.yml -f compose.clared.yml up -d
#   pnpm --filter ./apps/backend start
#
# Authentik compose.yml reads a *repo-root* .env (PG_PASS, AUTHENTIK_SECRET_KEY).
# This file is Nest-only (apps/backend/.env). Do not copy a production SECRET here
# — Coolify env only (D-02, D-13). SECRET=local-only is the laptop placeholder.

DATABASE_URL=postgresql://clared_app:clared_app_dev@127.0.0.1:5432/clared
REDIS_URL=redis://127.0.0.1:6379
AUTHENTIK_URL=http://localhost:9000
CLIENT_ID=clared
SECRET=local-only
BACKEND_URL=http://localhost:3000
CORS_ORIGINS=tauri://localhost,https://tauri.localhost,http://localhost:5174
# Unset or 0 for live Authentik. e2e sets AUTH_TEST_MODE=1 itself. Never set on Coolify.
AUTH_TEST_MODE=0
